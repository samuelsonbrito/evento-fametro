# Copie este arquivo para ".env" (na raiz do projeto) e preencha com as credenciais
# reais do MySQL. O ".env" nunca é versionado (ver .gitignore) — só este exemplo.
#
# Em produção (InfinityFree): confira no painel de hospedagem qual host usar para
# conexões vindas do próprio PHP hospedado lá (pode ser "localhost" ou o hostname do
# servidor de banco, dependendo de como a conta está configurada) — não confunda com o
# host usado por ferramentas externas (phpMyAdmin de desktop, etc.).

DB_HOST=localhost
DB_NAME=nome_do_banco
DB_USER=usuario_do_banco
DB_PASS=senha_do_banco

# Deixe AUSENTE (ou diferente de "true") em produção — mostra erro/stack trace na
# tela, útil só durante desenvolvimento manual fora do harness Docker (o harness já
# mostra erro por conta própria via harness/config.local.php, sem precisar disso).
# APP_DEBUG=true
